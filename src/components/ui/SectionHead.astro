---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  tone?: 'ink' | 'paper';
  class?: string;
}

const {
  eyebrow,
  title,
  lead,
  align = 'left',
  tone = 'ink',
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'max-w-2xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
>
  <p
    class:list={[
      'eyebrow flex items-center gap-2.5',
      align === 'center' && 'justify-center',
      tone === 'paper' ? 'text-brand-400' : 'text-brand-600',
    ]}
    data-reveal
  >
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-current"></span>
    {eyebrow}
  </p>

  <h2
    class:list={[
      'display-2 mt-5',
      tone === 'paper' ? 'text-paper' : 'text-ink',
    ]}
    data-reveal
    data-reveal-delay="0.06"
  >
    <Fragment set:html={title} />
  </h2>

  {
    lead && (
      <p
        class:list={[
          'mt-6 text-lg leading-relaxed',
          tone === 'paper' ? 'text-paper/60' : 'text-ink-3',
        ]}
        data-reveal
        data-reveal-delay="0.12"
      >
        {lead}
      </p>
    )
  }
</div>
