---
interface Props {
  name: 'web-development' | 'mobile-app-development' | 'iot-solutions' | 'system-integration';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    name === 'web-development' && (
      <>
        <rect x="3" y="6" width="26" height="20" rx="3" />
        <path d="M3 12h26" />
        <circle cx="7" cy="9" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="10.5" cy="9" r="0.9" fill="currentColor" stroke="none" />
        <path d="m13 17 2.5 2.5L13 22M18 22h4" />
      </>
    )
  }
  {
    name === 'mobile-app-development' && (
      <>
        <rect x="9" y="3" width="14" height="26" rx="3.5" />
        <path d="M14 6.5h4" />
        <path d="M13 14.5h6M13 19h4" />
        <circle cx="16" cy="25" r="1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'iot-solutions' && (
      <>
        <rect x="11" y="11" width="10" height="10" rx="2.5" />
        <path d="M16 4v7M16 21v7M4 16h7M21 16h7" />
        <circle cx="16" cy="4" r="1.6" />
        <circle cx="16" cy="28" r="1.6" />
        <circle cx="4" cy="16" r="1.6" />
        <circle cx="28" cy="16" r="1.6" />
      </>
    )
  }
  {
    name === 'system-integration' && (
      <>
        <circle cx="8" cy="8" r="4" />
        <circle cx="24" cy="24" r="4" />
        <rect x="19" y="3" width="10" height="10" rx="2.5" />
        <rect x="3" y="19" width="10" height="10" rx="2.5" />
        <path d="M11.5 10.5 19 18M13 24h6M24 13v6" />
      </>
    )
  }
</svg>
