---
/* A laptop running an admin dashboard with a companion phone app — the two
   things Lamacca actually ships. Drawn entirely in CSS so it stays crisp,
   costs no image bytes, and carries no invented statistics. */

const chart = [34, 52, 41, 66, 55, 78, 62, 88, 71, 96];
const navItems = [70, 55, 82, 48, 64, 58];
---

<div class="relative mx-auto w-full max-w-xl lg:max-w-none" data-hero-fade>
  <div class="relative pb-14 pl-6 sm:pb-16 sm:pl-10">
    {/* ---------------------------------------------------------------- laptop */}
    <div class="relative" data-parallax="22">
      {/* Silver aluminium lid: a thin brushed edge wrapping a dark bezel */}
      <div
        class="rounded-t-2xl bg-gradient-to-b from-[#f4f5f7] via-[#dcdee2] to-[#b4b8bf] p-1.5 shadow-[0_40px_80px_-40px_rgba(20,16,15,0.45)] ring-1 ring-inset ring-white/60"
      >
        <div class="rounded-t-[0.7rem] bg-[#1b1b1d] p-1 sm:p-[5px]">
          <div class="overflow-hidden rounded-md bg-paper">
          {/* window chrome */}
          <div
            class="flex items-center gap-2 border-b border-ink/8 bg-paper-2/70 px-3 py-2"
          >
            <span class="flex gap-1" aria-hidden="true">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-600/70"></span>
              <span class="h-1.5 w-1.5 rounded-full bg-amber/70"></span>
              <span class="h-1.5 w-1.5 rounded-full bg-mint/70"></span>
            </span>
            <span
              class="ml-1 h-3 flex-1 rounded-full bg-white"
              aria-hidden="true"
            ></span>
          </div>

          {/* app body */}
          <div class="flex aspect-[16/10]">
            {/* sidebar */}
            <div
              class="flex w-[22%] shrink-0 flex-col gap-2 border-r border-ink/8 bg-ink px-2.5 py-3 sm:gap-2.5 sm:px-3"
            >
              <span class="flex items-center gap-1.5" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-[3px] bg-brand-600"></span>
                <span class="h-1.5 w-8 rounded-full bg-white/25"></span>
              </span>
              <span class="mt-1.5 flex flex-col gap-2" aria-hidden="true">
                {
                  navItems.map((w, i) => (
                    <span class="flex items-center gap-1.5">
                      <span
                        class:list={[
                          'h-1.5 w-1.5 shrink-0 rounded-[2px]',
                          i === 1 ? 'bg-brand-600' : 'bg-white/20',
                        ]}
                      />
                      <span
                        class:list={[
                          'h-1.5 rounded-full',
                          i === 1 ? 'bg-white/50' : 'bg-white/15',
                        ]}
                        style={`width: ${w}%`}
                      />
                    </span>
                  ))
                }
              </span>
            </div>

            {/* main panel */}
            <div class="flex-1 p-3 sm:p-4">
              <div class="flex items-center justify-between" aria-hidden="true">
                <span class="h-2 w-20 rounded-full bg-ink/25"></span>
                <span class="h-4 w-12 rounded-full bg-brand-600"></span>
              </div>

              {/* stat tiles */}
              <div class="mt-3 grid grid-cols-3 gap-2" aria-hidden="true">
                {
                  ['bg-brand-600/12', 'bg-lilac/14', 'bg-mint/14'].map((tint, i) => (
                    <div class:list={['rounded-md p-2', tint]}>
                      <span class="block h-1 w-6 rounded-full bg-ink/20" />
                      <span
                        class:list={[
                          'mt-1.5 block h-2 rounded-full',
                          i === 0 ? 'bg-brand-600/70' : 'bg-ink/35',
                        ]}
                        style={`width: ${[70, 55, 62][i]}%`}
                      />
                    </div>
                  ))
                }
              </div>

              {/* chart */}
              <div
                class="mt-3 flex h-[38%] items-end gap-[3px] rounded-md bg-paper-2/60 p-2"
                aria-hidden="true"
              >
                {
                  chart.map((h, i) => (
                    <span
                      class="flex-1 rounded-t-[2px]"
                      style={`height: ${h}%; background: ${
                        i === chart.length - 1
                          ? 'var(--color-brand-600)'
                          : `color-mix(in oklab, var(--color-brand-600) ${14 + i * 5}%, var(--color-paper-3))`
                      }`}
                    />
                  ))
                }
              </div>

              {/* table rows */}
              <div class="mt-2.5 space-y-1.5" aria-hidden="true">
                {
                  [92, 76, 84].map((w) => (
                    <div class="flex items-center gap-2">
                      <span class="h-2 w-2 rounded-full bg-ink/12" />
                      <span
                        class="h-1.5 rounded-full bg-ink/12"
                        style={`width: ${w}%`}
                      />
                    </div>
                  ))
                }
              </div>
            </div>
            </div>
          </div>
        </div>
      </div>

      {/* Aluminium base — inset negatively on both sides so it stays centred */}
      <div class="relative h-3 sm:h-3.5" aria-hidden="true">
        <div
          class="absolute inset-y-0 -left-[4%] -right-[4%] rounded-b-xl bg-gradient-to-b from-[#c9ccd1] via-[#dcdee2] to-[#a8acb3] shadow-[0_10px_18px_-10px_rgba(20,16,15,0.5)]"
        >
          <span
            class="absolute left-1/2 top-0 h-[3px] w-16 -translate-x-1/2 rounded-b-full bg-[#8d9199]"
          ></span>
        </div>
      </div>
      <div
        class="mx-auto h-2 w-[70%] rounded-b-[50%] bg-ink/12 blur-md"
        aria-hidden="true"
      >
      </div>
    </div>

    {/* ----------------------------------------------------------------- phone */}
    <div
      class="float-slow absolute -left-1 bottom-0 w-[22%] max-w-[7.5rem]"
      data-parallax="-26"
    >
      <div
        class="rounded-[1.5rem] bg-ink p-1.5 shadow-[0_30px_60px_-25px_rgba(20,16,15,0.6)]"
      >
        <div class="relative overflow-hidden rounded-[1.1rem] bg-paper">
          {/* notch */}
          <span
            class="absolute left-1/2 top-1.5 h-1 w-8 -translate-x-1/2 rounded-full bg-ink/80"
            aria-hidden="true"></span>

          <div class="aspect-[9/18] px-2.5 pb-2 pt-5">
            {/* app header */}
            <div class="flex items-center gap-1.5" aria-hidden="true">
              <span class="h-4 w-4 rounded-full bg-brand-600"></span>
              <span class="flex flex-col gap-1">
                <span class="h-1 w-9 rounded-full bg-ink/25"></span>
                <span class="h-1 w-6 rounded-full bg-ink/12"></span>
              </span>
            </div>

            {/* map / hero block */}
            <div
              class="relative mt-2.5 h-[26%] overflow-hidden rounded-lg bg-mint/15"
              aria-hidden="true"
            >
              <span
                class="absolute left-1/2 top-1/2 h-3.5 w-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-brand-600"
              ></span>
              <span
                class="absolute left-1/2 top-1/2 h-6 w-6 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-600/20"
              ></span>
            </div>

            {/* primary action */}
            <span
              class="mt-2.5 block h-4 w-full rounded-full bg-brand-600"
              aria-hidden="true"></span>

            {/* list rows */}
            <div class="mt-2.5 space-y-1.5" aria-hidden="true">
              {
                [90, 72, 84, 66].map((w) => (
                  <div class="flex items-center gap-1.5">
                    <span class="h-2 w-2 shrink-0 rounded-[3px] bg-ink/10" />
                    <span class="h-1 rounded-full bg-ink/12" style={`width: ${w}%`} />
                  </div>
                ))
              }
            </div>

            {/* tab bar */}
            <div
              class="absolute inset-x-2.5 bottom-2 flex items-center justify-between rounded-full bg-ink px-2.5 py-1.5"
              aria-hidden="true"
            >
              {
                [0, 1, 2, 3].map((i) => (
                  <span
                    class:list={[
                      'h-1.5 w-1.5 rounded-full',
                      i === 0 ? 'bg-brand-400' : 'bg-white/25',
                    ]}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* dotted depth field */}
    <div
      class="pointer-events-none absolute inset-0 -z-10 -m-8 opacity-40"
      aria-hidden="true"
      style="background-image: radial-gradient(circle, rgba(20,16,15,0.16) 1px, transparent 1px); background-size: 22px 22px;"
    >
    </div>
  </div>
</div>
