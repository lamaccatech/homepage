---
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import { products } from '../../data/products';
import { accent } from '../../lib/accents';
---

<section class="shell py-24 lg:py-32">
  <div class="flex flex-wrap items-end justify-between gap-8">
    <SectionHead
      eyebrow="Our products"
      title="Platforms we built,<br />and keep building."
      lead="Products developed in-house and deployed with real organisations — each one ready to be tailored to how your institution works."
      class="max-w-xl"
    />
    <div data-reveal data-reveal-delay="0.16">
      <Button href="/products" variant="ghost">All products</Button>
    </div>
  </div>

  <div class="mt-16 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
    {
      products.map((product) => {
        const a = accent[product.accent];
        return (
          <a
            href={`/products#${product.slug}`}
            class="group relative flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-ink/8 bg-white p-7 transition-[transform,border-color] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1.5 hover:border-ink/18"
          >
            {/* Accent rail that fills on hover */}
            <span
              class:list={[
                'absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 transition-transform duration-600 ease-[var(--ease-out-expo)] group-hover:scale-x-100',
                a.solid,
              ]}
              aria-hidden="true"
            />

            <div class="flex items-center justify-between gap-3">
              <span class:list={['text-xs font-bold uppercase tracking-[0.12em]', a.text]}>
                {product.category}
              </span>
              <span class="flex gap-1.5">
                {product.platforms.map((p) => (
                  <span
                    class="rounded-full bg-paper-2 px-2.5 py-1 text-[0.6rem] font-semibold text-ink-3"
                    title={p}
                  >
                    {p === 'Web App' ? 'Web' : 'Mobile'}
                  </span>
                ))}
              </span>
            </div>

            <h3 class="mt-5 text-2xl font-bold tracking-tight text-ink">
              {product.name}
            </h3>
            <p class="mt-3 line-clamp-4 text-sm leading-relaxed text-ink-3">
              {product.summary}
            </p>

            <ul class="mt-6 space-y-2 border-t border-ink/8 pt-5">
              {product.features.slice(0, 3).map((f) => (
                <li class="flex items-start gap-2.5 text-xs text-ink-3">
                  <span
                    class:list={['mt-1.5 h-1 w-1 shrink-0 rounded-full', a.solid]}
                    aria-hidden="true"
                  />
                  {f}
                </li>
              ))}
              <li class="pt-1 text-xs font-semibold text-ink-4">
                +{product.features.length - 3} more capabilities
              </li>
            </ul>
          </a>
        );
      })
    }
  </div>
</section>
