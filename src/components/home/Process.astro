---
import SectionHead from '../ui/SectionHead.astro';
import { processSteps } from '../../data/services';
---

<section class="shell py-24 lg:py-32">
  <div class="grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    {/* Sticky column keeps the heading in view while the steps scroll past */}
    <div class="lg:sticky lg:top-32 lg:self-start">
      <SectionHead
        eyebrow="How we work"
        title="No black box.<br />Ever."
        lead="A six-month silence followed by a big reveal is how projects fail. You see the system as it is built."
      />
    </div>

    <ol class="relative" data-reveal-group>
      {
        processSteps.map((step, i) => (
          <li class="relative flex gap-6 pb-12 last:pb-0 sm:gap-8">
            {/* Connector line between markers */}
            {i < processSteps.length - 1 && (
              <span
                class="absolute left-[1.4rem] top-14 bottom-0 w-px bg-gradient-to-b from-ink/15 to-ink/0 sm:left-[1.65rem]"
                aria-hidden="true"
              />
            )}

            <span class="relative grid h-11 w-11 shrink-0 place-items-center rounded-full bg-ink text-xs font-bold text-paper sm:h-[3.3rem] sm:w-[3.3rem] sm:text-sm">
              {step.number}
            </span>

            <div class="pt-1.5">
              <h3 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">
                {step.title}
              </h3>
              <p class="mt-3 max-w-lg leading-relaxed text-ink-3">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
