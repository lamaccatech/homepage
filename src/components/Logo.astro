---
import LampMark from './brand/LampMark.astro';

interface Props {
  class?: string;
  /** Wordmark colour; the lamp always stays brand red. */
  tone?: 'ink' | 'paper';
}

const { class: className = '', tone = 'ink' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <LampMark
    class:list={[
      'h-8 w-auto shrink-0 transition-transform duration-500 ease-[var(--ease-spring)] group-hover:-rotate-6 group-hover:scale-110',
      // The 600 red goes muddy on ink, so lift it on dark surfaces.
      tone === 'paper' ? 'text-brand-400' : 'text-brand-600',
    ]}
  />
  <span class="flex flex-col leading-none">
    <span
      class={`text-[1.4rem] font-extrabold tracking-[-0.06em] ${
        tone === 'paper' ? 'text-paper' : 'text-ink'
      }`}
    >
      lamacca
    </span>
    <span
      class={`mt-0.5 hidden text-[0.5rem] font-semibold uppercase tracking-[0.14em] sm:block ${
        tone === 'paper' ? 'text-paper/60' : 'text-ink-3'
      }`}
    >
      Smart Technology Solution
    </span>
  </span>
</span>
