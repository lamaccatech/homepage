---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import ServiceIcon from '../components/ui/ServiceIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, processSteps } from '../data/services';
import { accent } from '../lib/accents';
---

<Base
  title="Services"
  description="Web development, mobile app development, IoT solutions, and system integration — delivered by one in-house team in Jakarta."
  transparentHeader
>
  <PageHero
    eyebrow="Services"
    title="Four disciplines.<br />One team that ships."
    lead="We scope, design, build, deploy, and maintain. The same people stay with your system from the first workshop through to the years after launch."
    meta={services.map((s) => s.title)}
  />

  {/* Service detail sections, alternating sides */}
  <section class="shell py-12 lg:py-20">
    <div class="space-y-6">
      {
        services.map((service, i) => {
          const a = accent[service.accent];
          return (
            <article
              id={service.slug}
              class="group relative scroll-mt-28 overflow-hidden rounded-[2rem] border border-ink/8 bg-white p-8 sm:p-12 lg:p-14"
              data-reveal
            >
              <span
                class:list={[
                  'pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full opacity-60 blur-3xl transition-opacity duration-700 group-hover:opacity-100',
                  a.soft,
                ]}
                aria-hidden="true"
              />

              <div
                class:list={[
                  'relative grid gap-10 lg:grid-cols-[1fr_0.85fr] lg:gap-16',
                  i % 2 === 1 && 'lg:grid-cols-[0.85fr_1fr]',
                ]}
              >
                <div class:list={[i % 2 === 1 && 'lg:order-2']}>
                  <div class="flex items-center gap-4">
                    <span
                      class:list={[
                        'grid h-14 w-14 shrink-0 place-items-center rounded-2xl transition-transform duration-500 ease-[var(--ease-spring)] group-hover:-rotate-6 group-hover:scale-110',
                        a.soft,
                        a.text,
                      ]}
                    >
                      <ServiceIcon name={service.slug as never} class="h-7 w-7" />
                    </span>
                    <span class="text-sm font-bold tabular-nums text-ink-4">
                      0{i + 1}
                    </span>
                  </div>

                  <h2 class="display-3 mt-7 text-ink">{service.title}</h2>
                  <p class="mt-5 text-lg leading-relaxed text-ink-2">
                    {service.summary}
                  </p>
                  <p class="mt-4 leading-relaxed text-ink-3">{service.detail}</p>
                </div>

                <div class:list={['lg:pt-4', i % 2 === 1 && 'lg:order-1']}>
                  <h3 class="eyebrow text-ink-4">What that includes</h3>
                  <ul class="mt-6 space-y-3">
                    {service.capabilities.map((cap) => (
                      <li class="flex items-start gap-3.5 rounded-2xl bg-paper-2/60 px-5 py-4 text-sm font-medium text-ink-2">
                        <span
                          class:list={['mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full', a.solid]}
                          aria-hidden="true"
                        />
                        {cap}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  {/* Process */}
  <section class="relative overflow-hidden bg-ink py-24 text-paper lg:py-32">
    <div class="shell">
      <SectionHead
        eyebrow="How we work"
        title="A process built<br />around visibility."
        lead="Every engagement follows the same four movements. You always know which one we are in."
        tone="paper"
      />

      <ol class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        {
          processSteps.map((step) => (
            <li class="rounded-[var(--radius-card)] border border-white/10 p-7 transition-colors duration-500 hover:border-white/25 hover:bg-white/[0.04]">
              <span class="text-2xl font-extrabold tabular-nums text-brand-400">
                {step.number}
              </span>
              <h3 class="mt-5 text-xl font-bold tracking-tight">{step.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-paper/55">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand
    title="Not sure which of these you need?"
    lead="Most of our engagements start as one thing and turn out to be another. Describe the problem and we will help you name it."
  />
</Base>
