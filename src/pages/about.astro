---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import LampMark from '../components/brand/LampMark.astro';
import Marquee from '../components/Marquee.astro';
import {
  management,
  engineers,
  coreValues,
  mission,
  vision,
  clients,
} from '../data/company';
import { stats } from '../data/site';
---

<Base
  title="About"
  description="PT Lamacca Kreatif Solusi is an Indonesia-based technology company founded in 2016, specialising in software development, IT consulting, and digital transformation."
  transparentHeader
>
  <PageHero
    eyebrow="About us"
    title="A technology partner,<br />not a vendor."
    lead="PT Lamacca Kreatif Solusi is an Indonesia-based technology company founded in 2016, specialising in software development, IT consulting, and digital transformation for government institutions, private companies, and organisations."
    meta={['Founded 2016', 'Jakarta, Indonesia', 'Government · Corporate · Organisation']}
  />

  {/* Founder's note */}
  <section class="shell py-20 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div data-reveal>
        <div
          class="relative overflow-hidden rounded-[var(--radius-card)] bg-ink p-8 text-paper"
        >
          <LampMark
            class="pointer-events-none absolute -bottom-10 -right-8 h-52 w-auto text-white/[0.05]"
          />
          <p class="relative eyebrow text-brand-400">From the CEO</p>
          <p class="relative mt-8 text-xl font-bold tracking-tight">
            Munawir Mukhtar Lutfi
          </p>
          <p class="relative mt-1 text-sm text-paper/50">
            Chief Executive Officer
          </p>
        </div>
      </div>

      <div>
        <p
          class="text-2xl leading-[1.45] tracking-[-0.02em] text-ink sm:text-[1.7rem]"
          data-reveal
        >
          We believe technology should create <span class="marker text-brand-600"
            >real impact</span
          >.
        </p>
        <div class="mt-7 space-y-5 leading-relaxed text-ink-3">
          <p data-reveal data-reveal-delay="0.06">
            Since 2016, our mission has been to deliver smart and tailored
            digital solutions — from software development to IT consulting —
            that help our partners grow and adapt in a digital-first world.
          </p>
          <p data-reveal data-reveal-delay="0.1">
            With a dedicated team and a strong focus on quality, we continue to
            support organisations across sectors in turning ideas into powerful,
            scalable systems.
          </p>
          <p data-reveal data-reveal-delay="0.14">
            Our goal is to simplify processes, enhance productivity, and create
            long-term value through innovative and scalable technology
            solutions. With a client-focused approach and a passion for digital
            excellence, we are your trusted partner in navigating the future of
            technology.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Stats */}
  <section class="border-y border-ink/8 bg-paper-2/50 py-16">
    <div class="shell grid grid-cols-2 gap-10 lg:grid-cols-4" data-reveal-group>
      {
        stats.map((stat) => (
          <div>
            <p class="flex items-baseline gap-0.5 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
              <span data-count={stat.value} data-count-format={stat.format}>
                {stat.value}
              </span>
              <span class="text-brand-600">{stat.suffix}</span>
            </p>
            <p class="mt-2.5 text-sm text-ink-3">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* Vision & mission */}
  <section class="shell py-24 lg:py-32">
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-16">
      {/* Sized to its content and pinned, so the solid red stays a highlight
          rather than a wall of colour next to the taller mission list. */}
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <div
          class="relative overflow-hidden rounded-[var(--radius-card)] bg-brand-600 p-9 text-white sm:p-12"
        >
          <div class="bg-noise pointer-events-none absolute inset-0 opacity-[0.06]"></div>
          <LampMark
            class="pointer-events-none absolute -bottom-14 -right-10 h-48 w-auto text-white/[0.09]"
          />
          <p class="eyebrow relative text-white/60">Our vision</p>
          <p
            class="relative mt-7 text-2xl font-bold leading-[1.25] tracking-[-0.03em] sm:text-[1.9rem]"
          >
            {vision}
          </p>
        </div>
      </div>

      <div data-reveal data-reveal-delay="0.08">
        <SectionHead eyebrow="Our mission" title="Five commitments." />
        <ol class="mt-9 space-y-4">
          {
            mission.map((m, i) => (
              <li class="flex gap-4 rounded-2xl border border-ink/8 bg-white p-5">
                <span class="text-xs font-bold tabular-nums text-brand-600">
                  0{i + 1}
                </span>
                <span class="text-sm leading-relaxed text-ink-2">{m}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* Core values */}
  <section class="relative overflow-hidden bg-ink py-24 text-paper lg:py-32">
    <div class="shell">
      <SectionHead
        eyebrow="Core values"
        title="Five words we<br />actually check ourselves against."
        lead="Our values guide the way we work, collaborate, and deliver impact — and our belief in the power of technology to drive positive change."
        tone="paper"
      />

      {/* Six-column base: the three top cards take two columns each and the
          two below take three, so five cards tile without leaving a gap. */}
      <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-6" data-reveal-group>
        {
          coreValues.map((value, i) => (
            <div
              class:list={[
                'group rounded-[var(--radius-card)] border border-white/10 p-8 transition-colors duration-500 hover:border-white/25 hover:bg-white/[0.04]',
                i < 3 ? 'lg:col-span-2' : 'lg:col-span-3',
                i === coreValues.length - 1 && 'sm:col-span-2',
              ]}
            >
              <span class="text-xs font-bold tabular-nums text-brand-400">
                0{i + 1}
              </span>
              <h3 class="mt-6 text-2xl font-bold tracking-tight">{value.title}</h3>
              <p class="mt-3 leading-relaxed text-paper/55">{value.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Team */}
  <section class="shell py-24 lg:py-32">
    <SectionHead
      eyebrow="The team"
      title="Ten people, one<br />delivery pipeline."
      lead="Our management team brings a background in technology, innovation, and project execution. Our engineers build the systems that back it up."
    />

    <div class="mt-16">
      <h3 class="eyebrow text-ink-4" data-reveal>Management</h3>
      <div
        class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5"
        data-reveal-group
      >
        {
          management.map((person) => (
            <div class="group rounded-[var(--radius-card)] border border-ink/8 bg-white p-6 transition-[transform,border-color] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:border-ink/20">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-brand-600/10 text-sm font-bold text-brand-600 transition-transform duration-500 ease-[var(--ease-spring)] group-hover:scale-110">
                {person.initials}
              </span>
              <p class="mt-5 font-bold leading-snug tracking-tight text-ink">
                {person.name}
              </p>
              <p class="mt-1.5 text-xs leading-relaxed text-ink-3">{person.role}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-14">
      <h3 class="eyebrow text-ink-4" data-reveal>Engineering</h3>
      <div
        class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5"
        data-reveal-group
      >
        {
          engineers.map((person) => (
            <div class="group rounded-[var(--radius-card)] border border-ink/8 bg-white p-6 transition-[transform,border-color] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:border-ink/20">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-ink/6 text-sm font-bold text-ink-2 transition-transform duration-500 ease-[var(--ease-spring)] group-hover:scale-110">
                {person.initials}
              </span>
              <p class="mt-5 font-bold leading-snug tracking-tight text-ink">
                {person.name}
              </p>
              <p class="mt-1.5 text-xs leading-relaxed text-ink-3">{person.role}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Clients */}
  <section class="border-y border-ink/8 bg-paper-2/50 py-16">
    <p class="eyebrow shell mb-9 text-center text-ink-4" data-reveal>
      Organisations we have worked with
    </p>
    <Marquee items={clients} duration={65} variant="pill" />
  </section>

  <CtaBand />
</Base>
