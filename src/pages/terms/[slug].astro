---
import type { GetStaticPaths } from 'astro';
import LegalDocument from '../../components/LegalDocument.astro';
import { termsOfService } from '../../data/legal';

export const getStaticPaths = (() => {
  return termsOfService.map((policy) => ({
    params: { slug: policy.slug },
    props: { policy },
  }));
}) satisfies GetStaticPaths;

const { policy } = Astro.props;

// The page chrome follows the language the terms are written in, as the privacy pages do.
const titles = {
  en: { documentTitle: 'Terms of Service', eyebrow: 'Terms of service' },
  id: { documentTitle: 'Ketentuan Layanan', eyebrow: 'Ketentuan layanan' },
} as const;
const { documentTitle, eyebrow } = titles[policy.lang];
---

<LegalDocument policy={policy} documentTitle={documentTitle} eyebrow={eyebrow} />
