---
import type { GetStaticPaths } from 'astro';
import LegalDocument from '../../components/LegalDocument.astro';
import { policies } from '../../data/privacy';

export const getStaticPaths = (() => {
  return policies.map((policy) => ({
    params: { slug: policy.slug },
    props: {
      policy,
      // Only per-market siblings cross-link; unrelated apps get no band.
      other: policy.related
        ? (policies.find((p) => p.slug === policy.related) ?? null)
        : null,
    },
  }));
}) satisfies GetStaticPaths;

const { policy, other } = Astro.props;
---

<LegalDocument policy={policy} other={other} documentTitle="Privacy Policy" />
