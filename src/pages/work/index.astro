---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import LampMark from '../../components/brand/LampMark.astro';
import { work, sectors } from '../../data/work';
import { accent } from '../../lib/accents';

const filters = ['All', ...sectors];
---

<Base
  title="Work"
  description="Selected engagements delivered by Lamacca for government institutions, public safety agencies, corporations, and organisations across Indonesia."
  transparentHeader
>
  <PageHero
    eyebrow="Selected work"
    title="Systems running in<br />ministries and boardrooms."
    lead="Grant management for the national police. Asset reconciliation for a provincial treasury. Real-time election monitoring. These are not concepts — they are in production."
    meta={[`${work.length} engagements`, 'Since 2016', 'Government · Corporate · Organisation']}
  />

  <section class="shell pb-12">
    {/* Sector filter */}
    <div
      class="flex flex-wrap gap-2.5 border-b border-ink/10 pb-8"
      role="group"
      aria-label="Filter projects by sector"
      data-reveal
    >
      {
        filters.map((filter) => (
          <button
            type="button"
            class="rounded-full border border-ink/12 px-5 py-2.5 text-sm font-semibold text-ink-2 transition-colors duration-300 hover:border-ink/30 aria-pressed:border-transparent aria-pressed:bg-ink aria-pressed:text-paper"
            data-filter={filter}
            aria-pressed={filter === 'All' ? 'true' : 'false'}
          >
            {filter}
          </button>
        ))
      }
    </div>

    <div
      class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3"
      data-work-grid
      data-reveal-group
    >
      {
        work.map((item) => {
          const a = accent[item.accent];
          return (
            <a
              href={`/work/${item.slug}`}
              class="group relative flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-ink/8 bg-white p-7 transition-[transform,border-color] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1.5 hover:border-ink/18"
              data-sector={item.sector}
            >
              <span
                class:list={[
                  'absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 transition-transform duration-600 ease-[var(--ease-out-expo)] group-hover:scale-x-100',
                  a.solid,
                ]}
                aria-hidden="true"
              />

              <div class="flex items-start justify-between gap-3">
                <span
                  class:list={[
                    'rounded-full px-3 py-1.5 text-[0.6rem] font-bold uppercase tracking-[0.1em]',
                    a.soft,
                    a.text,
                  ]}
                >
                  {item.sector}
                </span>
                <span class="text-xs font-semibold tabular-nums text-ink-4">
                  {item.year}
                </span>
              </div>

              {/* A screenshot where we have one, otherwise a tinted plate so
                  every card keeps the same rhythm instead of an empty gap. */}
              <figure class="mt-6 overflow-hidden rounded-2xl bg-paper-2">
                {
                  item.image ? (
                    <Image
                      src={item.image}
                      alt=""
                      widths={[320, 480, 640]}
                      sizes="(min-width: 1024px) 340px, (min-width: 768px) 45vw, 88vw"
                      class="aspect-[16/10] w-full object-cover object-top transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
                    />
                  ) : (
                    <div
                      class:list={[
                        'relative grid aspect-[16/10] w-full place-items-center overflow-hidden',
                        a.soft,
                      ]}
                    >
                      <div
                        class="absolute inset-0 opacity-50"
                        style="background-image: radial-gradient(circle, rgba(20,16,15,0.14) 1px, transparent 1px); background-size: 16px 16px;"
                      />
                      <LampMark
                        class:list={[
                          'absolute -bottom-6 -right-4 h-28 w-auto opacity-[0.16] transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:-rotate-6 group-hover:scale-110',
                          a.text,
                        ]}
                      />
                      <span
                        class:list={[
                          'relative px-6 text-center text-lg font-extrabold tracking-tight',
                          a.text,
                        ]}
                      >
                        {item.shortTitle}
                      </span>
                    </div>
                  )
                }
              </figure>

              <h2 class="mt-6 text-xl font-bold leading-snug tracking-tight text-ink">
                {item.title}
              </h2>
              <p class="mt-2.5 text-xs font-semibold text-ink-4">
                {item.clients.join(' · ')}
              </p>

              <p class="mt-4 line-clamp-4 flex-1 text-sm leading-relaxed text-ink-3">
                {item.summary}
              </p>

              <div class="mt-7 flex items-center justify-between border-t border-ink/8 pt-5">
                <span class="flex gap-1.5">
                  {item.platforms.map((p) => (
                    <span class="rounded-full bg-paper-2 px-2.5 py-1 text-[0.6rem] font-semibold text-ink-3">
                      {p === 'Web App' ? 'Web' : 'Mobile'}
                    </span>
                  ))}
                </span>
                <span class="grid h-9 w-9 place-items-center rounded-full border border-ink/12 transition-colors duration-400 group-hover:border-brand-600 group-hover:bg-brand-600 group-hover:text-white">
                  <svg
                    class="h-3.5 w-3.5 transition-transform duration-400 ease-[var(--ease-out-expo)] group-hover:translate-x-0.5"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M2 8h11m0 0L9 4m4 4-4 4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>

    <p class="mt-10 hidden text-center text-ink-3" data-empty-state>
      No projects in this sector yet.
    </p>
  </section>

  <CtaBand />
</Base>

<script>
  import { animate, stagger } from 'motion';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const grid = document.querySelector<HTMLElement>('[data-work-grid]');
  const empty = document.querySelector<HTMLElement>('[data-empty-state]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (grid) {
    const cards = Array.from(grid.children) as HTMLElement[];

    const apply = (filter: string) => {
      const visible: HTMLElement[] = [];

      cards.forEach((card) => {
        const match = filter === 'All' || card.dataset.sector === filter;
        card.hidden = !match;
        if (match) visible.push(card);
      });

      empty?.classList.toggle('hidden', visible.length > 0);

      if (!reduceMotion && visible.length) {
        animate(
          visible,
          { opacity: [0, 1], transform: ['translateY(14px) scale(0.98)', 'translateY(0) scale(1)'] },
          { duration: 0.45, delay: stagger(0.035), ease: [0.16, 1, 0.3, 1] },
        );
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        buttons.forEach((b) =>
          b.setAttribute('aria-pressed', String(b === button)),
        );
        apply(button.dataset.filter ?? 'All');
      });
    });
  }
</script>
