---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import LampMark from '../components/brand/LampMark.astro';
---

<Base title="Page not found" transparentHeader>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div
        class="blob absolute left-1/2 top-1/3 h-[34rem] w-[34rem] -translate-x-1/2 rounded-full bg-brand-400/16 blur-[110px]"
      >
      </div>
    </div>

    <div class="shell grid min-h-[80vh] place-items-center py-32 text-center">
      <div>
        <LampMark class="mx-auto h-20 w-auto text-brand-600 float-slow" />

        <p class="display-1 mt-10 text-ink">404</p>
        <h1 class="display-3 mt-4 text-ink">This page went dark.</h1>
        <p class="mx-auto mt-6 max-w-md leading-relaxed text-ink-3">
          The page you are looking for does not exist, or has moved somewhere
          better lit.
        </p>

        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <Button href="/" variant="primary">Back home</Button>
          <Button href="/work" variant="ghost">See our work</Button>
        </div>
      </div>
    </div>
  </section>
</Base>
