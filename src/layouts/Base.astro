---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LampSymbol from '../components/brand/LampSymbol.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Pages with a light hero need the header to start transparent. */
  transparentHeader?: boolean;
}

const {
  title,
  description = site.description,
  transparentHeader = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  slogan: site.tagline,
  foundingDate: String(site.founded),
  description: site.description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jl. SMA 14 No. 32, Cililitan, Kramat Jati',
    addressLocality: 'Jakarta Timur',
    addressRegion: 'DKI Jakarta',
    postalCode: '13640',
    addressCountry: 'ID',
  },
  email: 'info@lamacca.co.id',
  telephone: '+6281342337729',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fdfaf5" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Flag JS early so reveal elements can hide before first paint. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="min-h-dvh antialiased">
    <LampSymbol />

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-paper"
    >
      Skip to content
    </a>

    <div
      class="fixed inset-x-0 top-0 z-[90] h-[3px] origin-left scale-x-0 bg-brand-600"
      data-progress-bar
    >
    </div>

    <Header transparent={transparentHeader} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
